# Waveshare ESP32-S3-Touch-LCD-7 (ESP32-S3N16R8) + LVGL v9 clock
# Waveshare menuconfig (docs.waveshare.net ESP32-S3-Touch-LCD-7 Instructions):
#   FREERTOS_HZ=1000, CPU 240, FLASH QIO, OCT PSRAM, FETCH_INSTRUCTIONS, RODATA,
#   DATA_CACHE_LINE_64B, OPTIMIZATION_PERF - we have these.
#   They also want FLASHFREQ_120M + SPIRAM_SPEED_120M + IDF_EXPERIMENTAL_FEATURES
#   for max LCD FPS (~21 MHz PCLK demo). We keep matched 80M flash/PSRAM instead:
#   safer WiFi+RGB coexistence / less experimental; still use FETCH+RODATA+64B cache
#   (Espressif FAQ critical for RGB drift). LCD_RGB_RESTART_IN_VSYNC is ours (FAQ).
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_MEMTEST=n
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# FAQ RGB drift recovery (does not prevent; helps recover after underrun)
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y

# Keep more internal RAM for WiFi DMA; allow WiFi/LWIP in PSRAM
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=40960
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Slimmer WiFi buffers (RGB panel already hungry) — keep enough RX for TLS records
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=5
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_TX_BA_WIN=6
CONFIG_ESP_WIFI_RX_BA_WIN=6

# Large app for LVGL + WiFi (16MB flash board)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_OBJ_STYLE_CACHE=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_FONT_MONTSERRAT_14=y

# Boot stability
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Dynamic TX frees static DRAM (helps DRAM% vs STATIC_TX_NUM=8)
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER=y
CONFIG_ESP_WIFI_TX_BUFFER_TYPE=1

# mbedTLS on ESP-IDF 6.1 / mbedtls 4.x:
#   -0x008D = PSA_ERROR_INSUFFICIENT_MEMORY = MBEDTLS_ERR_SSL_ALLOC_FAILED
#   -0x0087 = PSA_ERROR_INVALID_ARGUMENT     = MBEDTLS_ERR_SSL_BAD_INPUT_DATA
# IN=4K caused -0x0087 on HKO/gov.hk (cert chain / handshake record > 4K).
# Restore full 16K IN; keep OUT smaller. DYNAMIC_BUFFER + DEFAULT_MEM_ALLOC
# put large peak buffers in PSRAM so DRAM stays usable with RGB.
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096

# CPU% meter in topbar (idle task run-time share)
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y

# LVGL adapter task stack in PSRAM is set at runtime in main.c (adapter_config.stack_in_psram).
# Do NOT enable CONFIG_ESP_LVGL_ADAPTER_LVGL_THREAD_STACK_IN_PSRAM with esp_lvgl_adapter 0.5.x +
# LVGL 9.6: CMake patch looks for #include "atomic.h" but LVGL 9.6 uses <freertos/atomic.h>,
# causing: unsupported LVGL FreeRTOS stack hook layout. Fixed upstream in adapter >= 0.7.2.
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=16