# Waveshare ESP32-S3-Touch-LCD-7 (ESP32-S3N16R8) + LVGL v9 clock
# Waveshare menuconfig (docs.waveshare.net ESP32-S3-Touch-LCD-7 Instructions):
#   FREERTOS_HZ=1000, CPU 240, FLASH QIO, OCT PSRAM, FETCH_INSTRUCTIONS, RODATA,
#   DATA_CACHE_LINE_64B, OPTIMIZATION_PERF.
# Official 09_lvgl_v9_demo uses matched FLASH+PSRAM 80M (not 120M).
# FLASHFREQ_120M + SPIRAM_SPEED_120M + HPM caused all-white screen after flash
# (CH422G backlight OK; RGB framebuffer / PSRAM XIP unusable). Keep matched 80M.
# LCD_RGB_RESTART_IN_VSYNC from Espressif RGB FAQ.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
# CONFIG_ESPTOOLPY_FLASHFREQ_120M is not set
# CONFIG_BOOTLOADER_FLASH_DC_AWARE is not set
# CONFIG_SPI_FLASH_HPM_ENA is not set
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_MEMTEST=n
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_SPEED_80M=y
# CONFIG_SPIRAM_SPEED_120M is not set
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# FAQ RGB drift recovery (does not prevent; helps recover after underrun)
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y

# Prefer PSRAM for most malloc; keep only tiny allocs in internal DRAM.
# Leaves contiguous internal for RGB bounce + WiFi DMA + HW AES (esp-aes).
# DRAM was ~93% with static TX + fat WiFi buffers -> AES/TLS -0x0084 alloc fail.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=24576
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# WiFi: SPIRAM_TRY_ALLOCATE_WIFI_LWIP forces STATIC TX (DYNAMIC depends on !TRY_ALLOCATE).
# Keep RX small; cut static TX count to limit internal DRAM (was DRAM 93%).
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=12
CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y
CONFIG_ESP_WIFI_TX_BUFFER_TYPE=0
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
# CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER is not set
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=4
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_TX_BA_WIN=4
CONFIG_ESP_WIFI_RX_BA_WIN=4
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=8
# Large app for LVGL + WiFi (16MB flash board)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_OBJ_STYLE_CACHE=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=1
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_FONT_MONTSERRAT_14=y

# Boot stability
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# mbedTLS on ESP-IDF 6.1 / mbedtls 4.x:
#   -0x008D = PSA_ERROR_INSUFFICIENT_MEMORY = MBEDTLS_ERR_SSL_ALLOC_FAILED
#   -0x0087 = PSA_ERROR_INVALID_ARGUMENT     = MBEDTLS_ERR_SSL_BAD_INPUT_DATA
# IN=16K required for HKO/gov.hk handshake records (4K caused -0x0087).
# EXTERNAL_MEM_ALLOC puts those buffers in PSRAM so internal largest~7-8K is OK.
# DYNAMIC_BUFFER frees TX/RX when idle; DYNAMIC_FREE_CONFIG_DATA frees after use.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC is not set
# CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC is not set
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
# If HW AES cannot obtain internal DMA RAM (esp-aes alloc fail / -0x0084),
# fall back to software AES rather than aborting the TLS record.
CONFIG_MBEDTLS_AES_SOFT_FALLBACK=y

# CPU% meter disabled: GENERATE_RUN_TIME_STATS + uxTaskGetSystemState caused
# 1 Hz RGB bounce underrun / vertical drift. Keep unset.
# CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS is not set
# CONFIG_FREERTOS_USE_TRACE_FACILITY is not set
# CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS is not set

# LVGL adapter task stack in PSRAM is set at runtime in main.c (adapter_config.stack_in_psram).
# Do NOT enable CONFIG_ESP_LVGL_ADAPTER_LVGL_THREAD_STACK_IN_PSRAM with esp_lvgl_adapter 0.5.x +
# LVGL 9.6: CMake patch looks for #include "atomic.h" but LVGL 9.6 uses <freertos/atomic.h>,
# causing: unsupported LVGL FreeRTOS stack hook layout. Fixed upstream in adapter >= 0.7.2.

# Slimmer lwIP (HTTPS still works; frees RAM for RGB bounce + AES DMA)
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=2880
CONFIG_LWIP_TCP_WND_DEFAULT=2880
CONFIG_LWIP_TCP_RECVMBOX_SIZE=4
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16
CONFIG_LWIP_MAX_ACTIVE_TCP=8
CONFIG_LWIP_MAX_LISTENING_TCP=4
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=3072
